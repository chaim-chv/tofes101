{
  "name": "tofes101",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "kb": "bun run scripts/kb.ts",
    "kb:check": "bun run scripts/kb.ts check",
    "kb:backlinks": "bun run scripts/kb.ts --write",
    "extract:form": "bun run tools/crawl/extract-form.ts && bun run tools/kb/gen-field-spec.ts",
    "crawl": "bun run tools/crawl/dump.ts",
    "test": "bun test",
    "check:fast": "bun run kb:check && bun test",
    "check:privacy": "bun run scripts/check-privacy.ts",
    "serve": "bun run tools/serve.ts",
    "verify": "bun run kb:check && bun test && bun run generate && bun run check:privacy && bun run e2e",
    "e2e": "bun run tools/e2e/flow.ts",
    "typecheck": "nuxt typecheck",
    "prepare": "nuxt prepare",
    "e2e:ci": "bun run tools/e2e/flow.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/ui": "^4.12.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bidi-js": "^1.1.0",
    "nuxt": "^4.6.3",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.6",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.14"
  }
}
